#include "zcommon.acs"
#include "constant.acs"

// Scripts

Script "GAG_ARK" (int tag, int oceanSector, int sector3D) // This script is used to sink the ark
{
	if (CheckInventory(YELLOWCARD))
	{
        SetResultValue(TRUE);
		int sector3DZDelta = GetSectorCeilingZ(sector3D, 0, 0) - GetSectorFloorZ(oceanSector, 0, 0) + 1;
        Delay(35 * 4);
        Floor_MoveToValue(tag, NORMAL, 128, 1);
        FloorAndCeiling_LowerByValue(sector3D, NORMAL, sector3DZDelta);
        ChangeFloor(tag, FWATER1);
        Delay(140);
        Polyobj_MoveTimes8(2, 128, 0, 300);
        Thing_SetConversation(KENT_ID, 686);
	}
	else
    {
		Print(s:YELLOW_KEYCARD_DENY);
        SetResultValue(FALSE);
    }
}

Script "GAG_DSAREA" (int location) // Prints the Dark Souls area name on screen
{
    AmbientSound(DSAREA, DSAREA_VOLUME);
    switch (location)
    {
        case CATHEDRAL_ID:
            DSAreaFunc(CATHEDRAL_NAME);
            break;
        
        case MINE_ID:
            DSAreaFunc(MINE_NAME);
            break;
		
		case ARK_ID:
			DSAreaFunc(ARK_NAME);
            break;
    }
}

Script "GAG_GOULD" (void) // A thoughtful eulogy for Stephen J. Gould
{
	HudMessage(s:GOULD_EULOGY; HUDMSG_PLAIN, 0, CR_UNTRANSLATED, 0.5, 0.35, 5.0);
}

Script "GAG_DAPPER" (int lineID, int leftActorMoverID, int rightActorMoverID) // Initiates the Dapper Dinosaur scripted cameo scene
{
    //ACS_NamedExecute("MUSIC_CROSSFADE", 0, NONE);
	Floor_LowerToNearest(0, NORMAL);
    Delay(70);
    AmbientSound(DAPPERTHEME, 100);
    Delay(120);
    Thing_Activate(leftActorMoverID);
    Thing_Activate(rightActorMoverID);
    Line_SetBlocking(lineID, 0, BLOCKF_EVERYTHING);
}

Script "GAG_TOILET" (int id, int fountainID) // Legally mandated toilet flushing gag
{
    PlaySound(id, FLUSH);
    Delay(32);

    int pos[3] = {GetActorX(fountainID), GetActorY(fountainID), GetActorZ(fountainID)};

    for (int i = 0; i < 32; i++)
    {
        SpawnParticle(0x1982b1, FALSE, Random(35, 55), 4, pos[0], pos[1], pos[2], Random(-1.0, 1.0), Random(-1.0, 1.0), Random(2.0, 4.0), 0.0, 0.0, -0.5, 255, 0);
    }
}

Script "GAG_MADEYOULOOK" (int lookTarget, int spawnTarget) // Tricks the player into looking behind them but spawns in a monster instead
{
    HudMessage(s:SECRET_LOOKBEHINDYOU; HUDMSG_PLAIN, 1, CR_UNTRANSLATED, 0.5, 0.35, 5.0);
    until (CheckSight(0, lookTarget, 0) && GetActorAngle(0) - VectorAngle(GetActorX(lookTarget) - GetActorX(0), GetActorY(lookTarget) - GetActorY(0)) < 32)
    {
        Delay(10);
    }
    HudMessage(s:HAHAHA; HUDMSG_PLAIN, 1, CR_UNTRANSLATED, 0.5, 0.35, 5.0);
    until (GetActorAngle(0) - VectorAngle(GetActorX(spawnTarget) - GetActorX(0), GetActorY(spawnTarget) - GetActorY(0)) < 32)
    {
        Delay(10);
    }
    Floor_LowerInstant(0, 0, 8);
    Thing_SpawnFacing(spawnTarget, T_DEMON, TRUE, 0);
}

function void DSAreaFunc(int name) // Dark Souls area name; all in one, easy-to-use function
{
    HudMessage(s:name; HUDMSG_FADEINOUT, 0, CR_UNTRANSLATED, DSAREA_X, DSAREA_Y, DSAREA_HOLDTIME, DSAREA_FADETIME, DSAREA_FADETIME);
}
